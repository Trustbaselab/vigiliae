# ---------------------------------------------------------------------------
# Vigiliae configuration. Copy to .env and edit. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- access control ---------------------------------------------------------
# Generate one with:
#   python -c "import secrets; print('bot-' + secrets.token_urlsafe(24))"
# Leave empty to run in open dev mode (NOT recommended on a public VPS).
BOT_TOKEN=

# --- server -----------------------------------------------------------------
# 0.0.0.0 is required inside Docker. On bare metal, prefer 127.0.0.1 behind
# nginx/Caddy (see docs/DEPLOY.md).
VIGILIAE_HOST=0.0.0.0
VIGILIAE_PORT=8110
VIGILIAE_DATA_DIR=./data
VIGILIAE_AGENTS=./agents.yaml
VIGILIAE_TZ_OFFSET=8
VIGILIAE_HEARTBEAT_TIMEOUT=120

# Optional: an external task bus that receives run results (POST JSON).
VIGILIAE_TASK_BUS_URL=

# --- thinking kernel (optional) --------------------------------------------
# Vigiliae does not ship an LLM. It shells out to a CLI that accepts a prompt.
# DSH is the reference implementation: https://github.com/deepseek-ai/dsh
# Any CLI with the same "prompt in, answer out" shape works.
DSH_BIN=dsh
DSH_PROFILE=headless
DSH_HOME=
DSH_TIMEOUT=180
DSH_DAILY_LIMIT=200
# DSH_CWD=/opt/your-agent-workspace

# --- off-peak pricing -------------------------------------------------------
# Peak = weekdays 09:00-12:00 and 14:00-18:00 local time.
# Everything else is treated as off-peak (roughly half price at some providers).
# Optional comma-separated ISO holidays, e.g. 2026-01-01,2026-02-17
VIGILIAE_HOLIDAYS=
# Task id answered by the chat command `inspect`
VIGILIAE_INSPECT_TASK=inspect
